<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/Project/UI/esc/PizzaMenu.uss?fileID=7433441132597879392&amp;guid=b74b174e32f20424c907873ca7cd9952&amp;type=3#PizzaMenu" />
    <ui:VisualElement name="MainController" class="screen">
        <ui:VisualElement name="MenuPanel" class="menu-panel">
            <ui:VisualElement class="brand-plate">
                <ui:Label text="PEPPERONI PAT'S" class="brand-small" />
                <ui:Label text="PIZZA PATROL" class="brand-large" />
            </ui:VisualElement>

            <ui:VisualElement name="TabHeader" class="tab-header">
                <ui:Button text="ORDERS" name="DailyMenuButton" class="tab-button" />
                <ui:Button text="UPGRADES" name="UpgradesButton" class="tab-button" />
                <ui:Button text="MAP" name="MapButton" class="tab-button tab-button--selected" />
                <ui:Button text="CHALLENGES" name="ChallengesButton" class="tab-button" />
                <ui:Button text="OPTIONS" name="OptionsButton" class="tab-button" />
            </ui:VisualElement>

            <ui:VisualElement name="ContentArea" class="content-area">
                <ui:VisualElement name="OrdersPage" class="page orders-page">
                    <ui:VisualElement name="QuestListPanel" class="quest-list-panel">
                        <ui:Label text="ORDERS RECEIVED" class="panel-title orders-title" />
                        <ui:ScrollView name="QuestListScroll" class="quest-list-scroll" vertical-scroller-visibility="Hidden" horizontal-scroller-visibility="Hidden">
                            <ui:VisualElement class="quest-item quest-item--selected">
                                <ui:Label text="GRANDMA" class="quest-item-portrait grandma-portrait" />
                                <ui:VisualElement class="quest-item-text">
                                    <ui:Label text="HUNGRY GRANDMA" class="quest-item-title" />
                                    <ui:Label text="PIN  Sunset Street 12" class="quest-item-subtext" />
                                    <ui:Label text="CLOCK  Time Limit: 15:00" class="quest-item-time" />
                                </ui:VisualElement>
                                <ui:Label text="NEW" class="quest-item-status" />
                            </ui:VisualElement>
                            <ui:VisualElement class="quest-item">
                                <ui:Label text="BUILDER" class="quest-item-portrait builder-portrait" />
                                <ui:VisualElement class="quest-item-text">
                                    <ui:Label text="BUILD SITE DELIVERY" class="quest-item-title" />
                                    <ui:Label text="PIN  Construction Zone" class="quest-item-subtext" />
                                    <ui:Label text="CLOCK  Time Limit: 20:00" class="quest-item-time" />
                                </ui:VisualElement>
                                <ui:Label text="IN PROGRESS" class="quest-item-status progress-status" />
                            </ui:VisualElement>
                            <ui:VisualElement class="quest-item">
                                <ui:Label text="MOVIE" class="quest-item-portrait movie-portrait" />
                                <ui:VisualElement class="quest-item-text">
                                    <ui:Label text="MOVIE NIGHT FEAST" class="quest-item-title" />
                                    <ui:Label text="PIN  Riverside Apartments" class="quest-item-subtext" />
                                    <ui:Label text="CLOCK  Time Limit: 18:00" class="quest-item-time" />
                                </ui:VisualElement>
                                <ui:Label text="NEW" class="quest-item-status" />
                            </ui:VisualElement>
                            <ui:VisualElement class="quest-item">
                                <ui:Label text="DINER" class="quest-item-portrait diner-portrait" />
                                <ui:VisualElement class="quest-item-text">
                                    <ui:Label text="LATE NIGHT CRAVING" class="quest-item-title" />
                                    <ui:Label text="PIN  Dark Alley Diner" class="quest-item-subtext" />
                                    <ui:Label text="CLOCK  Time Limit: 12:00" class="quest-item-time" />
                                </ui:VisualElement>
                                <ui:Label text="NEW" class="quest-item-status" />
                            </ui:VisualElement>
                            <ui:VisualElement class="quest-item quest-item--locked">
                                <ui:Label text="ZOMBIE" class="quest-item-portrait zombie-portrait" />
                                <ui:VisualElement class="quest-item-text">
                                    <ui:Label text="ZOMBIE HUNTER PACK" class="quest-item-title" />
                                    <ui:Label text="PIN  Survivor Camp" class="quest-item-subtext" />
                                    <ui:Label text="CLOCK  Time Limit: 25:00" class="quest-item-time" />
                                </ui:VisualElement>
                                <ui:Label text="LOCKED" class="quest-item-status locked-status" />
                            </ui:VisualElement>
                        </ui:ScrollView>
                    </ui:VisualElement>
                    <ui:VisualElement name="QuestDetailPanel" class="quest-detail-panel">
                        <ui:Label text="ORDER DETAILS" class="panel-title detail-panel-title" />
                        <ui:ScrollView name="QuestDetailScroll" class="quest-detail-scroll" vertical-scroller-visibility="Hidden" horizontal-scroller-visibility="Hidden">
                            <ui:VisualElement name="QuestDetailHeader" class="quest-detail-header">
                                <ui:Label text="GRANDMA" name="QuestDetailPortrait" class="quest-detail-portrait grandma-portrait" />
                                <ui:VisualElement class="quest-heading">
                                    <ui:Label text="HUNGRY GRANDMA" name="QuestDetailTitle" class="quest-detail-title" />
                                    <ui:Label text="PIN  Sunset Street 12" name="QuestLocation" class="quest-detail-location" />
                                </ui:VisualElement>
                            </ui:VisualElement>
                            <ui:Label text="My oven's busted and I'm starving!&#10;Please deliver a hot pizza before I turn into a zombie...&#10;I'll make it worth your while!" name="QuestDescription" class="quest-description" />
                            <ui:VisualElement class="section-rule" />
                            <ui:Label text="DELIVERY REQUIREMENTS" class="sub-title" />
                            <ui:VisualElement name="RequirementRow" class="requirement-row">
                                <ui:Label text="PIZZA" name="RequiredItemIcon" class="required-item-icon" />
                                <ui:VisualElement class="requirement-copy">
                                    <ui:Label text="Deliver the following pizza:" class="requirement-caption" />
                                    <ui:Label text="1 x Mamma's Margherita" name="RequiredItemText" class="requirement-text" />
                                </ui:VisualElement>
                            </ui:VisualElement>
                            <ui:VisualElement class="section-rule" />
                            <ui:Label text="REWARDS" class="sub-title" />
                            <ui:VisualElement name="RewardRow" class="reward-row">
                                <ui:Label text="$ 250  COINS" name="CoinReward" class="reward-card" />
                                <ui:Label text="* 150  EXP" name="ExpReward" class="reward-card" />
                                <ui:Label text="P 2  REPUTATION" name="ReputationReward" class="reward-card" />
                            </ui:VisualElement>
                        </ui:ScrollView>
                        <ui:Button text="ACCEPT ORDER  &gt;" name="AcceptQuestButton" class="accept-button" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:VisualElement name="MapPage" class="page map-page">
                    <ui:VisualElement name="MapMainPanel" class="map-main-panel">
                        <ui:VisualElement name="LocalMapView" class="map-view">
                            <ui:VisualElement name="MapCanvas" class="map-canvas local-map-view">
                                <ui:Label text="PIZZA YOU" name="LocalPlayerMarker" class="map-marker player-marker" />
                                <ui:Label text="!" name="LocalQuestMarker" class="map-marker quest-marker" />
                                <ui:Label text="HOME BASE" class="map-callout base-callout" />
                                <ui:Label text="ACTIVE DELIVERY" class="map-callout quest-callout" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement class="map-tip">
                            <ui:Label text="TIP: Drag or zoom the map to explore the neighborhood." />
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <ui:ScrollView class="legend-panel" vertical-scroller-visibility="Hidden" horizontal-scroller-visibility="Hidden">
                        <ui:Label text="MAP LEGEND" class="panel-title" />
                        <ui:Label text="P  Current location" class="legend-item" />
                        <ui:Label text="!  Active order" class="legend-item" />
                        <ui:Label text="V  Destination" class="legend-item" />
                        <ui:Label text="OK Completed area" class="legend-item" />
                        <ui:Label text="$  Shop" class="legend-item" />
                        <ui:Label text="X  Danger zone" class="legend-item" />
                        <ui:Label text="H  Home base" class="legend-item" />
                        <ui:VisualElement class="controls-block">
                            <ui:Label text="MAP CONTROLS" class="panel-title" />
                            <ui:Label text="+  Zoom in" class="control-item" />
                            <ui:Label text="-  Zoom out" class="control-item" />
                            <ui:Label text="O  Center player" class="control-item" />
                            <ui:Label text="[] Full map" class="control-item" />
                        </ui:VisualElement>
                    </ui:ScrollView>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
