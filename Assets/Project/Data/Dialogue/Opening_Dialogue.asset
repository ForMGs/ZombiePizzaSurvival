  lines:
  - speakerName: "\uAE40\uB8E8\uBBF8"
    portrait: {fileID: 21300000, guid: 947d99c16cb5f6245aba08217f5e1ed2, type: 3}
    dialogue: "\uC9C0\uAE08 \uC5B4\uB5BB\uAC8C \uB41C \uC77C\uC774\uC9C0?\n\uC73C
      .. \uB108\uBB34 \uCD94\uC6CC \uC6B0\uC120 \uBC16\uC73C\uB85C \uB098\uAC00\uC790."
  - speakerName: "\uAE40\uB8E8\uBBF8"
    portrait: {fileID: 21300000, guid: f3df7da05200e2b46ad0b32a7e276b16, type: 3}
    dialogue: "\uC6B0\uC120 \uD734\uB300\uC804\uD654\uBD80\uD130 \uCC3E\uC544\uC11C
      \uC0C1\uD669\uC744 \uC54C\uC544\uC57C\uACA0\uB2E4.\n(\uC0AC\uC7A5\uB2D8\uC740....
      \uC5B4\uB514 \uAC00\uC2E0\uAC70\uC9C0?)"
