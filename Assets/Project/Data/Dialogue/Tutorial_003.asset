  lines:
  - speakerName: "\uAE40\uB8E8\uBBF8"
    portrait: {fileID: 21300000, guid: 8d2c95a310e415446bf456ef74a0c81e, type: 3}
    dialogue: "\uBB50\uC57C.. \uC774 \uC7AC\uB09C\uBB38\uC790\uB294? \uC880\uBE44\uC0AC\uD0DC?
      \n\uC601\uD654\uC5D0\uC11C\uB9CC \uBCF4\uB358 \uC880\uBE44\uAC00 \uD604\uC2E4\uC5D0\uC11C
      \uC77C\uC5B4\uB0A0 \uC904\uC774\uC57C..."
  - speakerName: "\uAE40\uB8E8\uBBF8"
    portrait: {fileID: 21300000, guid: f3df7da05200e2b46ad0b32a7e276b16, type: 3}
    dialogue: "\uBC16\uC744 \uB098\uAC00\uC11C \uC0C1\uD669\uC744 \uC0B4\uD3B4\uC57C
      \uACA0\uC5B4.. \uC6B0\uC120 \uB3C4\uC6C0\uC774 \uB420\uB9CC\uD55C \uBB34\uAE30\uB97C
      \uCC59\uACA8\uC57C\uACA0\uB2E4.\n\uD654\uB355 \uC606\uC5D0 \uC800 \uBC29\uB9DD\uC774\uB97C
      \uCC59\uAE30\uC790."
